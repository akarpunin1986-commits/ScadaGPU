# ═══════════ OpenAI Client Pool (singleton) ═══════════
_openai_clients: dict[str, "AsyncOpenAI"] = {}

def _get_openai_client(api_key: str, base_url: str | None, timeout: int) -> "AsyncOpenAI":
    """Reuse AsyncOpenAI client to keep TCP connections alive (connection pooling)."""
    from openai import AsyncOpenAI
    cache_key = f"{api_key[:8]}:{base_url or 'default'}"
    client = _openai_clients.get(cache_key)
    if client is None:
        client = AsyncOpenAI(api_key=api_key, timeout=timeout, base_url=base_url)
        _openai_clients[cache_key] = client
        logger.info("Created new OpenAI client pool for %s", cache_key)
    return client

