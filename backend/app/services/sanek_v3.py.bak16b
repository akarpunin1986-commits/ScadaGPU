def _auto_enrich(text: str, tools_called: set[str]) -> str:
    """Auto-append sources and follow-up question if LLM forgot."""
    t = text
    # 1. Sources — always add if missing
    if "f4cc" not in t and "📌" not in t and "источник" not in t.lower() and tools_called:
        srcs = list(dict.fromkeys(_SRC_MAP[tool] for tool in tools_called if tool in _SRC_MAP))
        if srcs:
            t = t.rstrip() + f"\n\n📌 Источники: {', '.join(srcs)}"
    # 2. Follow-up — only if LLM didn't already ask a question
    has_question = "?" in t[-200:] or "💬" in t
    if not has_question and len(t) > 100 and tools_called:
        import random
        for tool in reversed(list(tools_called)):
            if tool in _FOLLOWUP_MAP:
                options = _FOLLOWUP_MAP[tool]
                q = random.choice(options) if isinstance(options, list) else options
                t = t.rstrip() + f"\n\n💬 {q}"
                break
    return t


def _extract_dialog_button(text: str) -> tuple[str, dict | None]:
    """Convert 💬 question at end of text into clarification button."""
    m = re.search(r'💬\s*(.+?)$', text)
    if not m:
        return text, None
    q = m.group(1).strip()
    clean = text[:m.start()].rstrip()
    # Split "X или Y?" into 2 buttons
    parts = re.split(r'\s+или\s+', q.rstrip('?'))
    if len(parts) >= 2:
        opts = [p.strip().rstrip('?.!') for p in parts if p.strip()]
    else:
        opts = [q.rstrip('?')]
    if len(opts) == 1:
        opts.append("Нет, спасибо")
    return clean, {"question": q, "type": "single_select", "options": opts[:4]}


class SanekV3Engine:
    def __init__(self, provider: str, api_key: str, model: str, conv_id: str = ""):
        self.provider = provider
        self.api_key = api_key
        self.model = model
        self.conv_id = conv_id
        self._assistant = SanekAssistant(provider=provider, api_key=api_key, model=model, conv_id=conv_id)

    async def chat_stream(self, messages: list[dict], pending_action: Optional[dict] = None):
        _tool_cache_clear()
        _current_conv_id.set(self.conv_id)

        if pending_action:
            confirm = {"да","yes","подтверждаю","ок","ok","давай","выполняй","делай","go"}
            last = ""
            for m in reversed(messages):
                if m.get("role") == "user":
                    last = m.get("content", "").strip().lower()
                    break
            if any(w in last for w in confirm):
                res = await tool_registry.execute(pending_action["tool"], pending_action["args"])
                yield {"type": "done", "message": f"✅ Выполнено: {pending_action.get('description','')}\n\n{json.dumps(res, ensure_ascii=False)[:500]}", "actions": [{"tool": pending_action["tool"], "args": pending_action["args"]}], "pending_action": None}
            else:
                yield {"type": "done", "message": "❌ Отменено.", "actions": [], "pending_action": None}
            return

        yield {"type": "mode", "mode": "deep"}

        topology = await _build_topology_compact()
        memories = ""
        try:
            mem = await _load_memories(user_id=None)
            if mem:
                memories = f"\nПАМЯТЬ ОПЕРАТОРА:\n{mem}"
        except Exception:
            pass

        user_msg = messages[-1].get("content", "") if messages else ""
        learned = await _build_learned_context(user_msg)

        prompt = SANEK_V3_PROMPT.format(topology_compact=topology, active_memories=memories, learned_context=f"\n{learned}" if learned else "")
        full_messages = [{"role": "system", "content": prompt}] + messages

        try:
            hint = _detect_correction(messages)
            if hint:
                full_messages.append({"role": "system", "content": hint})
        except Exception:
            pass

        use_openai = self.provider in ("openai", "grok")

        if use_openai:
            base_url = "https://api.x.ai/v1" if self.provider == "grok" else None
            client = _get_openai_client(self.api_key, base_url, settings.AI_TIMEOUT)
        tools_openai = tool_registry.get_openai_tools()

        tracker = ToolCallTracker()
        actions = []
        tools_called: set[str] = set()

        for iteration in range(MAX_ITERATIONS):
            full_messages = _trim_context(full_messages, self.provider, self.model, 4096)

            # SSE progress: let user know what's happening
            if iteration == 0:
                yield {"type": "thinking", "step": "analyzing_query", "detail": "Выбираю инструменты..."}
            else:
                yield {"type": "thinking", "step": "analyzing_results", "detail": f"Анализирую данные от {', '.join(tools_called)}..."}

            if use_openai:
                try:
                    tp = "max_completion_tokens" if "gpt-5" in self.model else "max_tokens"
                    response = await asyncio.wait_for(
                        client.chat.completions.create(model=self.model, messages=full_messages, tools=tools_openai, temperature=0, **{tp: 2048}),
                        timeout=30
                    )
                except asyncio.TimeoutError:
                    yield {"type": "error", "message": "⏱ GPT думал слишком долго (>30с). Попробуйте ещё раз — обычно повторный запрос быстрее."}
                    return
                except Exception as e:
                    yield {"type": "error", "message": _format_llm_error(self.provider, e)}
                    return
                choice = response.choices[0]
            else:
                try:
                    v2r = await self._assistant.chat(full_messages, pending_action=None)
                    t = _format_response(_validate_response(_strip_fluff(_humanize(v2r.get("message", ""))), tools_called))
                    t = _auto_enrich(t, tools_called)
                    cl, clar = _extract_clarification(t)
                    if not clar:
                        cl, clar = _extract_dialog_button(cl)
                    done = {"type": "done", "message": cl, "actions": v2r.get("actions", []), "pending_action": v2r.get("pending_action")}
                    if clar:
                        done["clarification"] = clar
                    yield done
                    return
                except asyncio.TimeoutError:
                    yield {"type": "error", "message": "⏱ GPT думал слишком долго (>30с). Попробуйте ещё раз — обычно повторный запрос быстрее."}
                    return
                except Exception as e:
                    yield {"type": "error", "message": _format_llm_error(self.provider, e)}
                    return

            if choice.message.tool_calls:
                full_messages.append(choice.message.model_dump())
                for tc in choice.message.tool_calls:
                    yield {"type": "step", "tool": tc.function.name, "status": "running", "description": _step_description(tc.function.name, tc.function.arguments or "")}

                async def _exec(tc):
                    name = tc.function.name
                    args = json.loads(tc.function.arguments) if tc.function.arguments else {}
                    dup = tracker.check(name, args)
                    if dup:
                        return tc.id, name, args, {"error": dup}
                    if tool_registry.is_dangerous(name):
                        return tc.id, name, args, {"__pending__": {"tool": name, "args": args, "description": f"{name}: {json.dumps(args, ensure_ascii=False)[:200]}"}}
                    try:
                        result = await asyncio.wait_for(tool_registry.execute(name, args), timeout=TOOL_TIMEOUT)
                    except asyncio.TimeoutError:
                        result = {"error": f"Таймаут {TOOL_TIMEOUT}с"}
                    except Exception as e:
                        result = {"error": str(e)}
                    return tc.id, name, args, result

                # Parallel tool execution
                results = await asyncio.gather(*[_exec(tc) for tc in choice.message.tool_calls], return_exceptions=True)
                pending = None
                for res in results:
                    if isinstance(res, Exception):
                        continue
                    tc_id, name, args, result = res
                    tools_called.add(name)
                    if isinstance(result, dict) and "__pending__" in result:
                        pending = result["__pending__"]
                        full_messages.append({"role": "tool", "tool_call_id": tc_id, "content": json.dumps({"status": "pending_confirmation"})})
                        yield {"type": "step", "tool": name, "status": "done"}
                        continue
                    yield {"type": "step", "tool": name, "status": "done"}
                    actions.append({"tool": name, "args": args})
                    summary = json.dumps(result, ensure_ascii=False, default=str)
                    if len(summary) > 8000:
                        summary = summary[:7000] + "\n...[сокращено]"
                    full_messages.append({"role": "tool", "tool_call_id": tc_id, "content": summary})
                if pending:
                    yield {"type": "done", "message": f"⚙️ Предложено: {pending['description']}\n\nПодтвердить?", "actions": actions, "pending_action": pending}
                    return
                continue

            # Final response from LLM
            raw = choice.message.content or ""
            t = _format_response(_validate_response(_strip_fluff(_humanize(raw)), tools_called))
            t = _auto_append_downloads(t, full_messages)
            t = _auto_enrich(t, tools_called)
            cl, clar = _extract_clarification(t)
            if not clar:
                cl, clar = _extract_dialog_button(cl)
            # If tokens were already streamed and text was modified by post-processing,
            # send the full processed text; otherwise frontend already has it via tokens
            done = {"type": "done", "message": cl, "actions": [{"tool": a["tool"], "args": a.get("args",{})} for a in actions], "pending_action": None}
            if clar:
                done["clarification"] = clar
            yield done
            return

        yield {"type": "done", "message": "Лимит итераций. Задайте конкретнее.", "actions": [], "pending_action": None}


# ═══════════ SSE ENDPOINT ═══════════

async def chat_stream_v3(request, save_history: bool = True):
    from fastapi.responses import StreamingResponse
    from models.base import async_session
    from models.ai_chat import AiChatMessage

    body = await request.json()
    message = body.get("message", "")
    session_id = body.get("session_id") or str(uuid.uuid4())

    if not message.strip():
        async def empty():
            yield f"data: {json.dumps({'type':'error','message':'Пустое сообщение'})}\n\n"
        return StreamingResponse(empty(), media_type="text/event-stream")

    try:
        from api.ai_parser import _get_active_provider, _get_api_key, _get_model
        provider = _get_active_provider()
        api_key = _get_api_key(provider)
        model = _get_model(provider)
    except Exception:
        provider = settings.AI_PROVIDER
        km = {"openai": settings.OPENAI_API_KEY, "claude": settings.CLAUDE_API_KEY, "gemini": settings.GEMINI_API_KEY, "grok": settings.GROK_API_KEY}
        mm = {"openai": settings.OPENAI_MODEL, "claude": settings.CLAUDE_MODEL, "gemini": settings.GEMINI_MODEL, "grok": settings.GROK_MODEL}
        api_key = km.get(provider, "")
        model = mm.get(provider, "")

    messages = []
    try:
        async with async_session() as db:
            rows = (await db.execute(select(AiChatMessage).where(AiChatMessage.session_id == session_id).order_by(AiChatMessage.created_at).limit(20))).scalars().all()
            for row in rows:
                if row.role in ("user", "assistant"):
                    messages.append({"role": row.role, "content": row.content})
    except Exception:
        pass

    messages.append({"role": "user", "content": message})
    engine = SanekV3Engine(provider=provider, api_key=api_key, model=model, conv_id=session_id)

    async def gen():
        last_resp = ""
        try:
            async for event in engine.chat_stream(messages, None):
                if event.get("type") == "done":
                    last_resp = event.get("message", "")
                    event["session_id"] = session_id
                yield f"data: {json.dumps(event, ensure_ascii=False, default=str)}\n\n"
        except Exception as e:
            logger.error("V3 stream: %s", e, exc_info=True)
            yield f"data: {json.dumps({'type':'error','message':str(e)})}\n\n"
        if save_history and session_id:
            try:
                async with async_session() as db:
                    db.add(AiChatMessage(session_id=session_id, role="user", content=message))
                    if last_resp:
                        db.add(AiChatMessage(session_id=session_id, role="assistant", content=last_resp))
                    await db.commit()
            except Exception:
                pass

    return StreamingResponse(gen(), media_type="text/event-stream", headers={"Cache-Control": "no-cache", "X-Accel-Buffering": "no"})
