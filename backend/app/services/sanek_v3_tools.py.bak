@registry.tool(
    name="execute_code",
    description="Execute Python in sandbox (10-20s). For: file generation (Excel/PDF/PNG), complex calcs, Bitrix tasks, data export. NOT for: metrics, summary, alarms (use fast tools). RULES: sync Python, DB via psycopg2.connect(CONTEXT['db_dsn']). Pandas: conn=psycopg2.connect(CONTEXT['db_dsn']); df=pandas.read_sql(sql,conn); conn.close(). НЕ используй sqlalchemy!. Files: save to OUTPUT_DIR. Result: RESULT=dict. BLOCKED: os/sys/subprocess/INSERT/UPDATE/DELETE. Sites: MKZ=3(dev 1,2,3) YKZ=5(dev 4,5,6). ВАЖНО: device_type в БД = 'GENERATOR' или 'ATS' (UPPERCASE enum!). Используй LOWER(device_type::text) или device_type='GENERATOR'. PDF font: /usr/share/fonts/truetype/dejavu/DejaVuSans.ttf. get_code_context NOT required. EXCEL RULES: 1) Sections with colored headers (merge_cells, PatternFill) 2) Separate tables for: energy, gas, economics - DO NOT mix 3) Headers with borders, auto-width columns 4) Total rows with bold font and fill 5) Number format: #,##0.0 for float, #,##0 for int ВАЖНО: когда файл создан, ОБЯЗАТЕЛЬНО включи в ответ ссылку: [имя_файла.xlsx](/reports/имя_файла.xlsx)"
                "Use ONLY when needed: file (Excel/PDF/PNG), non-standard calc, Bitrix task, data export. "
                "DO NOT use for: current metrics, summary, alarms - use fast tools. "
                "get_code_context НЕ нужен.",
    parameters={
        "code": {"type": "string", "description": "Python code. Sync. Result in RESULT. Files in OUTPUT_DIR."},
        "context": {"type": "object", "description": "Data from dialog (opt). Available as CONTEXT in code."},
        "cross_check": {"type": "object", "description": "Cross-check params (opt): {type:'economics', site_id:3, last_days:7}"},
    },
    required=["code"]
)
async def tool_execute_code(code: str, context: dict = None, cross_check: dict = None, **kwargs):
    from services.code_executor import execute_code, cross_check_economics

    # Auto-inject standard context if not provided
    if context is None:
        context = {}
    # db_dsn and redis_url are injected by code_executor, but ensure they're there
    result = await execute_code(code, context)

    response = {}

    if result.get("blocked"):
        return {"error": result["error"], "blocked": True}

    if result.get("error"):
        response["error"] = result["error"]
        if result.get("stdout"):
            response["partial_output"] = result["stdout"][:2000]
        response["hint"] = "Code failed. Check error. You can fix and call execute_code again (max 2 attempts)."
        return response

    if result.get("return_value") is not None:
        rv_str = json.dumps(result["return_value"], ensure_ascii=False, default=str)
        if len(rv_str) > 8000:
            rv_str = rv_str[:8000] + "...[truncated]"
        try:
            response["result"] = json.loads(rv_str)
        except Exception:
            response["result"] = rv_str

    if result.get("stdout"):
        response["output"] = result["stdout"][:3000]

    if result.get("files"):
        response["files"] = result["files"]
        # Add download URLs for frontend
        response["download_links"] = []
        for f in result["files"]:
            fname = f.split("/")[-1] if "/" in f else f
            response["download_links"].append(f"/reports/{fname}")
        if response["download_links"]:
            response["download_url"] = response["download_links"][0]
            response["download_hint"] = f"Файл готов. Вставь ссылку: [{fname}]({response['download_url']})"

    if cross_check and cross_check.get("type") == "economics":
        warning = await cross_check_economics(
            result,
            site_id=cross_check.get("site_id"),
            last_days=cross_check.get("last_days", 7)
        )
        if warning:
            response["cross_check_warning"] = warning["warning"]

    return response
