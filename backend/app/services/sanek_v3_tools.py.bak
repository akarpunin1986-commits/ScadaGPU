@registry.tool(
    name="get_energy_report",
    description="Отчёт по энергии/потреблению за период. Выработка генераторов, потребление из сети, энергобаланс. ИСПОЛЬЗУЙ для вопросов: потребление/выработка/энергия за N часов/дней.",
    parameters={
        "site_id": {"type": "integer", "description": "ID объекта (3=МКЗ, 5=ЯКЗ). Если не указан — оба."},
        "last_hours": {"type": "integer", "description": "За N часов (24)"},
    }
)
async def get_energy_report(site_id: int = None, last_hours: int = 24, **kwargs):
    async with async_session() as db:
        cutoff = datetime.utcnow() - timedelta(hours=last_hours)
        site_ids = [site_id] if site_id else [3, 5]
        result = {"period_hours": last_hours, "sites": []}

        for sid in site_ids:
            site = await db.get(Site, sid)
            if not site:
                continue
            devices = (await db.execute(
                select(Device).where(and_(Device.site_id == sid, Device.is_active == True))
            )).scalars().all()

            site_data = {
                "site_id": sid, "site_name": site.name, "site_code": site.code,
                "generators": [], "ats": None,
                "total_gen_energy_kwh": 0, "total_mains_energy_kwh": 0,
            }

            for dev in devices:
                dtype = dev.device_type.value
                p_field = "power_total" if dtype == "generator" else "mains_total_p"
                p_col = getattr(MetricsData, p_field, MetricsData.power_total)

                # Single query: all aggregates at once
                row = (await db.execute(
                    select(
                        func.min(MetricsData.energy_kwh).label("e_min"),
                        func.max(MetricsData.energy_kwh).label("e_max"),
                        func.avg(p_col).label("p_avg"),
                        func.min(p_col).label("p_min"),
                        func.max(p_col).label("p_max"),
                        func.count().label("cnt"),
                    ).where(and_(
                        MetricsData.device_id == dev.id,
                        MetricsData.timestamp >= cutoff
                    ))
                )).one()

                energy = round(float(row.e_max - row.e_min), 1) if row.e_max is not None and row.e_min is not None else 0

                dev_data = {
                    "device_id": dev.id,
                    "name": dev.name,
                    "type": dtype,
                    "energy_kwh": energy,
                    "power_avg_kw": round(float(row.p_avg), 1) if row.p_avg else 0,
                    "power_min_kw": round(float(row.p_min), 1) if row.p_min else 0,
                    "power_max_kw": round(float(row.p_max), 1) if row.p_max else 0,
                    "records": row.cnt or 0,
                }

                if dtype == "generator":
                    site_data["generators"].append(dev_data)
                    site_data["total_gen_energy_kwh"] += energy
                else:
                    site_data["ats"] = dev_data
                    site_data["total_mains_energy_kwh"] = energy

            site_data["total_gen_energy_kwh"] = round(site_data["total_gen_energy_kwh"], 1)
            site_data["total_mains_energy_kwh"] = round(site_data["total_mains_energy_kwh"], 1)
            result["sites"].append(site_data)

        return result


@registry.tool(name="query_data", description="Универсальный SQL-запрос к metrics_data. Для аналитики, агрегации, трендов.", parameters={"device_ids": {"type": "array", "items": {"type": "integer"}, "description": "ID устройств"}, "fields": {"type": "array", "items": {"type": "string"}, "description": "Поля: power_total, energy_kwh, coolant_temp, oil_pressure, engine_speed, mains_total_p, busbar_p, frequency, run_hours"}, "last_hours": {"type": "integer", "description": "За N часов (24)"}, "aggregation": {"type": "string", "enum": ["avg","min","max","sum","count","none"], "description": "Агрегация (avg)"}, "group_by": {"type": "string", "enum": ["device","hour","day"], "description": "Группировка (device)"}}, required=["device_ids", "fields"])
async def query_data(device_ids: list = None, fields: list = None, last_hours: int = 24, aggregation: str = "avg", group_by: str = "device", **kwargs):
    async with async_session() as db:
        cutoff = datetime.utcnow() - timedelta(hours=last_hours)
        if not device_ids or not fields:
            return {"error": "device_ids and fields required"}
        valid_fields = {f for f in fields if hasattr(MetricsData, f)}
        if not valid_fields:
            return {"error": f"Invalid fields: {fields}"}
        results = []
        if group_by == "device":
            for did in device_ids:
                dev = await db.get(Device, did)
                dname = dev.name if dev else f"device_{did}"
                row = {"device_id": did, "device_name": dname}
                for f in valid_fields:
                    col = getattr(MetricsData, f)
                    agg_fn = {"avg": func.avg, "min": func.min, "max": func.max, "sum": func.sum, "count": func.count}.get(aggregation, func.avg)
                    val = (await db.execute(select(agg_fn(col)).where(and_(MetricsData.device_id == did, MetricsData.timestamp >= cutoff)))).scalar()
                    row[f] = round(float(val), 2) if val is not None else None
                    if aggregation == "avg":
                        mn = (await db.execute(select(func.min(col)).where(and_(MetricsData.device_id == did, MetricsData.timestamp >= cutoff)))).scalar()
                        mx = (await db.execute(select(func.max(col)).where(and_(MetricsData.device_id == did, MetricsData.timestamp >= cutoff)))).scalar()
                        row[f"{f}_min"] = round(float(mn), 2) if mn is not None else None
                        row[f"{f}_max"] = round(float(mx), 2) if mx is not None else None
                results.append(row)
        elif group_by in ("hour", "day"):
            bucket_fn = func.date_trunc(group_by, MetricsData.timestamp)
            for did in device_ids:
                dev = await db.get(Device, did)
                dname = dev.name if dev else f"device_{did}"
                cols_sel = [bucket_fn.label("bucket")]
                for f in valid_fields:
                    agg_fn = {"avg": func.avg, "min": func.min, "max": func.max, "sum": func.sum, "count": func.count}.get(aggregation, func.avg)
                    cols_sel.append(agg_fn(getattr(MetricsData, f)).label(f))
                rows = (await db.execute(select(*cols_sel).where(and_(MetricsData.device_id == did, MetricsData.timestamp >= cutoff)).group_by(bucket_fn).order_by(bucket_fn))).all()
                for r in rows:
                    row = {"device_id": did, "device_name": dname, "period": _utc_to_msk(r.bucket)}
                    for f in valid_fields:
                        row[f] = round(float(getattr(r, f)), 2) if getattr(r, f) is not None else None
                    results.append(row)
        else:
            for did in device_ids:
                rows = (await db.execute(select(MetricsData).where(and_(MetricsData.device_id == did, MetricsData.timestamp >= cutoff)).order_by(MetricsData.timestamp.desc()).limit(50))).scalars().all()
                for r in rows:
                    row = {"device_id": did, "timestamp": _utc_to_msk(r.timestamp)}
                    for f in valid_fields:
                        row[f] = getattr(r, f, None)
                    results.append(row)
        return {"data": results, "count": len(results), "period_hours": last_hours, "aggregation": aggregation}

