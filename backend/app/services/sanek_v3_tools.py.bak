"""
САНЁК v3 — Tool Layer.
Прямой Redis/PostgreSQL. Tool Registry. Device-type agnostic.
Сложные tools делегируют в v2 через execute_tool.
Включает tools самообучения: get_action_effectiveness.
"""
from __future__ import annotations

import asyncio, json, logging
from datetime import datetime, timedelta
from typing import Any, Callable, Optional

from sqlalchemy import select, and_, or_, func, desc, text
from sqlalchemy.orm import selectinload

from config import settings
from models.base import async_session
from models.device import Device, DeviceType
from models.site import Site
from models.alarm_event import AlarmEvent
from models.scada_event import ScadaEvent
from models.metrics_data import MetricsData
from models.maintenance import MaintenanceLog
from models.maintenance_alert import MaintenanceAlert
from models.ai_knowledge import AiKnowledgeChunk
from models.sanek_memory import SanekMemory
from models.sanek_action import SanekAction
from models.gas_price import GasPrice
from models.device_type_registry import DeviceTypeRegistry
from models.sop_procedure import SopProcedure
from services.reference_cache import definitions_cache

logger = logging.getLogger("sanek.v3.tools")

_API_BASE = "http://127.0.0.1:8000"

# ═══════════ REDIS SINGLETON ═══════════

_redis_client = None

async def _get_redis():
    """Lazy Redis singleton. Единственное определение для всего v3."""
    global _redis_client
    if _redis_client is None:
        from redis.asyncio import Redis as AioRedis
        _redis_client = AioRedis.from_url(settings.REDIS_URL, decode_responses=True)
    return _redis_client


# ═══════════ TOOL REGISTRY ═══════════

class ToolRegistry:
    def __init__(self):
        self._tools: dict[str, dict] = {}
        self._dangerous: set[str] = set()

    def tool(self, name: str, description: str, parameters: dict,
             required: list[str] = None, dangerous: bool = False):
        def decorator(func: Callable):
            self._tools[name] = {
                "func": func,
                "definition": {
                    "name": name, "description": description,
                    "parameters": {"type": "object", "properties": parameters, "required": required or []},
                },
            }
            if dangerous:
                self._dangerous.add(name)
            return func
        return decorator

    async def execute(self, name: str, args: dict) -> dict:
        entry = self._tools.get(name)
        if not entry:
            return {"error": f"Неизвестный tool: {name}"}
        try:
            return await entry["func"](**args)
        except Exception as e:
            logger.error("Tool %s error: %s", name, e, exc_info=True)
            return {"error": f"Ошибка {name}: {str(e)}"}

    def is_dangerous(self, name: str) -> bool:
        return name in self._dangerous

    def get_openai_tools(self) -> list[dict]:
        return [{"type": "function", "function": t["definition"]} for t in self._tools.values()]

    @property
    def tool_names(self) -> set[str]:
        return set(self._tools.keys())


registry = ToolRegistry()


# ═══════════ HELPERS ═══════════

async def _get_cached_device_types() -> dict:
    cached = definitions_cache.get("device_types")
    if cached is not None:
        return cached
    async with async_session() as db:
        rows = (await db.execute(select(DeviceTypeRegistry))).scalars().all()
        result = {}
        for r in rows:
            result[r.type_code] = {
                "display_name": r.display_name, "metrics_schema": r.metrics_schema or {},
                "thresholds": r.thresholds or {}, "statuses": r.statuses or {},
                "nominal_values": r.nominal_values or {},
                "status_field": r.status_field, "running_status_code": r.running_status_code,
            }
    definitions_cache.set("device_types", result)
    return result

def _utc_to_msk(dt) -> str:
    if not dt:
        return ""
    if isinstance(dt, str):
        try:
            dt = datetime.fromisoformat(dt.replace("Z", "").replace("+00:00", ""))
        except Exception:
            return dt
    return (dt + timedelta(hours=3)).strftime("%Y-%m-%d %H:%M MSK")


# ═══════════════════════════════════════════════════
# TOOLS: ДАННЫЕ
# ═══════════════════════════════════════════════════

@registry.tool(name="get_system_summary", description="Полная сводка ВСЕХ объектов: устройства, мощность, статусы, аварии. ИСПОЛЬЗУЙ для вопросов про объект/площадку (потребление/статус/сводка МКЗ/ЯКЗ).", parameters={})
async def get_system_summary(**kwargs):
    redis = await _get_redis()
    device_types = await _get_cached_device_types()
    async with async_session() as db:
        sites = (await db.execute(select(Site).where(Site.is_active == True).options(selectinload(Site.devices)))).scalars().all()
        active_alarms = (await db.execute(select(AlarmEvent).where(AlarmEvent.is_active == True))).scalars().all()
        alarm_by_device = {}
        for a in active_alarms:
            alarm_by_device.setdefault(a.device_id, []).append({"code": a.alarm_code, "severity": a.severity, "message": a.message, "since": _utc_to_msk(a.occurred_at)})
    result = {"sites": [], "total_alarms": len(active_alarms)}
    for site in sites:
        sd = {"id": site.id, "name": site.name, "code": site.code, "devices": [], "gen_power_kw": 0, "mains_power_kw": 0}
        for device in site.devices:
            if not device.is_active:
                continue
            raw = await redis.get(f"device:{device.id}:metrics")
            m = json.loads(raw) if raw else {}
            dtype = device.device_type.value
            ti = device_types.get(dtype, {})
            sf = ti.get("status_field", "gen_status")
            sc = m.get(sf)
            sl = ti.get("statuses", {}).get(str(sc), f"status={sc}")
            rc = ti.get("running_status_code", 9)
            running = (sc == rc and m.get("online", False))
            pwr = m.get("power_total", 0) if dtype == "generator" else m.get("mains_total_p", 0)
            if dtype == "generator" and running:
                sd["gen_power_kw"] += pwr or 0
            elif dtype == "ats":
                sd["mains_power_kw"] = pwr or 0
            di = {"id": device.id, "name": device.name, "type": dtype, "online": m.get("online", False), "status": sl, "is_running": running, "power_kw": round(pwr or 0, 1), "nominal_kw": ti.get("nominal_values", {}).get("power")}
            if dtype == "generator":
                di.update({"coolant_temp": m.get("coolant_temp"), "oil_pressure": m.get("oil_pressure"), "engine_speed": m.get("engine_speed"), "run_hours": m.get("run_hours")})
            al = alarm_by_device.get(device.id, [])
            if al:
                di["alarms"] = al
            if not m.get("online"):
                di["warning"] = "НЕТ СВЯЗИ"
            elif not running and dtype == "generator":
                di["warning"] = f"ОСТАНОВЛЕН ({sl})"
            sd["devices"].append(di)
        sd["total_power_kw"] = round(sd["gen_power_kw"] + sd["mains_power_kw"], 1)
        result["sites"].append(sd)
    return result


@registry.tool(name="get_metrics", description="Текущие метрики устройства из Redis.", parameters={"device_id": {"type": "integer", "description": "ID устройства"}}, required=["device_id"])
async def get_metrics(device_id: int, **kwargs):
    redis = await _get_redis()
    raw = await redis.get(f"device:{device_id}:metrics")
    if not raw:
        return {"error": f"Нет данных для device_id={device_id}"}
    metrics = json.loads(raw)
    dtype = metrics.get("device_type", "generator")
    types = await _get_cached_device_types()
    thresholds = types.get(dtype, {}).get("thresholds", {})
    assessments = {}
    for mk, rules in thresholds.items():
        v = metrics.get(mk)
        if v is None:
            continue
        a = "normal"
        if "critical" in rules and v >= rules["critical"]:
            a = "critical"
        elif "critical_low" in rules and v <= rules["critical_low"]:
            a = "critical"
        elif "warn" in rules and v >= rules["warn"]:
            a = "warning"
        elif "warn_low" in rules and v <= rules["warn_low"]:
            a = "warning"
        if a != "normal":
            assessments[mk] = {"level": a, "value": v, "thresholds": rules}
    if assessments:
        metrics["_assessments"] = assessments
    return metrics


@registry.tool(name="get_alarms", description="Текущие АКТИВНЫЕ аварии.", parameters={"device_id": {"type": "integer", "description": "ID устройства (опц.)"}, "site_id": {"type": "integer", "description": "ID объекта (опц.)"}})
async def get_alarms(device_id: int = None, site_id: int = None, **kwargs):
    async with async_session() as db:
        q = select(AlarmEvent).where(AlarmEvent.is_active == True)
        if device_id:
            q = q.where(AlarmEvent.device_id == device_id)
        alarms = (await db.execute(q.order_by(AlarmEvent.occurred_at.desc()))).scalars().all()
        if site_id and not device_id:
            sdi = set((await db.execute(select(Device.id).where(Device.site_id == site_id))).scalars().all())
            alarms = [a for a in alarms if a.device_id in sdi]
        dids = {a.device_id for a in alarms}
        dn = {}
        if dids:
            devs = (await db.execute(select(Device).where(Device.id.in_(dids)))).scalars().all()
            dn = {d.id: d.name for d in devs}
        return {"alarms": [{"device_id": a.device_id, "device_name": dn.get(a.device_id, f"#{a.device_id}"), "alarm_code": a.alarm_code, "severity": a.severity, "message": a.message, "since": _utc_to_msk(a.occurred_at), "duration_min": round((datetime.utcnow() - a.occurred_at).total_seconds() / 60, 1) if a.occurred_at else 0} for a in alarms], "count": len(alarms)}


@registry.tool(name="get_alarm_history", description="Архив аварий за период.", parameters={"device_id": {"type": "integer", "description": "ID устройства (опц.)"}, "last_hours": {"type": "integer", "description": "За N часов (168)"}, "limit": {"type": "integer", "description": "Макс записей (100)"}})
async def get_alarm_history(device_id: int = None, last_hours: int = 168, limit: int = 100, **kwargs):
    async with async_session() as db:
        cutoff = datetime.utcnow() - timedelta(hours=last_hours)
        q = select(AlarmEvent).where(or_(AlarmEvent.occurred_at >= cutoff, AlarmEvent.is_active == True))
        if device_id:
            q = q.where(AlarmEvent.device_id == device_id)
        alarms = (await db.execute(q.order_by(AlarmEvent.occurred_at.desc()).limit(limit))).scalars().all()
        dids = {a.device_id for a in alarms}
        dn = {d.id: d.name for d in (await db.execute(select(Device).where(Device.id.in_(dids)))).scalars().all()} if dids else {}
        return [{"device_id": a.device_id, "device_name": dn.get(a.device_id, f"#{a.device_id}"), "alarm_code": a.alarm_code, "severity": a.severity, "message": a.message, "occurred_at": _utc_to_msk(a.occurred_at), "cleared_at": _utc_to_msk(a.cleared_at), "is_active": a.is_active} for a in alarms]


@registry.tool(name="get_events", description="Журнал событий: запуски, остановки, переключения.", parameters={"device_id": {"type": "integer", "description": "ID (опц.)"}, "site_id": {"type": "integer", "description": "ID объекта (опц.)"}, "last_hours": {"type": "integer", "description": "N часов (24)"}, "limit": {"type": "integer", "description": "Макс (100)"}})
async def get_events(device_id: int = None, site_id: int = None, last_hours: int = 24, limit: int = 100, **kwargs):
    async with async_session() as db:
        cutoff = datetime.utcnow() - timedelta(hours=last_hours)
        q = select(ScadaEvent).where(ScadaEvent.created_at >= cutoff)
        if device_id:
            q = q.where(ScadaEvent.device_id == device_id)
        elif site_id:
            q = q.where(ScadaEvent.device_id.in_((await db.execute(select(Device.id).where(Device.site_id == site_id))).scalars().all()))
        return [{"device_id": e.device_id, "category": e.category, "event_code": e.event_code, "message": e.message, "time": _utc_to_msk(e.created_at)} for e in (await db.execute(q.order_by(ScadaEvent.created_at.desc()).limit(limit))).scalars().all()]


@registry.tool(name="get_history", description="История метрик с downsampling.", parameters={"device_id": {"type": "integer", "description": "ID устройства"}, "last_hours": {"type": "integer", "description": "N часов (24)"}, "fields": {"type": "string", "description": "Поля через запятую (опц.)"}}, required=["device_id"])
async def get_history(device_id: int, last_hours: int = 24, fields: str = None, **kwargs):
    async with async_session() as db:
        cutoff = datetime.utcnow() - timedelta(hours=last_hours)
        device = await db.get(Device, device_id)
        if not device:
            return {"error": f"Устройство {device_id} не найдено"}
        dtype = device.device_type.value
        if not fields:
            fields = {"generator": "power_total,coolant_temp,oil_pressure,engine_speed,energy_kwh", "ats": "mains_total_p,busbar_p,energy_kwh"}.get(dtype, "power_total")
        fl = [f.strip() for f in fields.split(",")]
        # Smart downsampling: always aggregate to keep response small
        if last_hours > 168:
            bucket = "day"
        elif last_hours > 48:
            bucket = "hour"
        else:
            bucket = "hour"  # 24h => hourly = max 24 points
        tt = func.date_trunc(bucket, MetricsData.timestamp)
        agg_cols = [tt.label("bucket")]
        for f in fl:
            if hasattr(MetricsData, f):
                col = getattr(MetricsData, f)
                if f == "energy_kwh":
                    agg_cols.append(func.min(col).label(f"{f}_min"))
                    agg_cols.append(func.max(col).label(f"{f}_max"))
                else:
                    agg_cols.append(func.avg(col).label(f))
                    agg_cols.append(func.min(col).label(f"{f}_min"))
                    agg_cols.append(func.max(col).label(f"{f}_max"))
        rows = (await db.execute(select(*agg_cols).where(and_(MetricsData.device_id == device_id, MetricsData.timestamp >= cutoff)).group_by(tt).order_by(tt))).all()
        result = []
        for r in rows:
            point = {"timestamp": _utc_to_msk(r.bucket)}
            for f in fl:
                if f == "energy_kwh":
                    point[f"energy_min"] = round(getattr(r, f"{f}_min", None) or 0, 2)
                    point[f"energy_max"] = round(getattr(r, f"{f}_max", None) or 0, 2)
                    point[f"energy_delta"] = round((getattr(r, f"{f}_max", None) or 0) - (getattr(r, f"{f}_min", None) or 0), 2)
                else:
                    point[f] = round(getattr(r, f, None) or 0, 2)
                    point[f"{f}_min"] = round(getattr(r, f"{f}_min", None) or 0, 2)
                    point[f"{f}_max"] = round(getattr(r, f"{f}_max", None) or 0, 2)
            result.append(point)
        return result


@registry.tool(name="get_maintenance_status", description="Статус ТО: моточасы, следующее ТО.", parameters={"device_id": {"type": "integer", "description": "ID устройства"}}, required=["device_id"])
async def get_maintenance_status(device_id: int, **kwargs):
    redis = await _get_redis()
    raw = await redis.get(f"device:{device_id}:metrics")
    rh = json.loads(raw).get("run_hours", 0) if raw else 0
    async with async_session() as db:
        ll = (await db.execute(select(MaintenanceLog).where(MaintenanceLog.device_id == device_id).order_by(MaintenanceLog.performed_at.desc()).limit(1))).scalar_one_or_none()
        als = (await db.execute(select(MaintenanceAlert).where(and_(MaintenanceAlert.device_id == device_id, MaintenanceAlert.status != "resolved")))).scalars().all()
    return {"device_id": device_id, "run_hours": rh, "last_maintenance": {"date": _utc_to_msk(ll.performed_at), "hours_at": ll.engine_hours} if ll else None, "alerts": [{"severity": str(a.severity), "message": a.message, "hours_remaining": a.hours_remaining} for a in als]}


@registry.tool(name="get_economics_report", description="Экономика: газ, выработка, себестоимость.", parameters={"site_id": {"type": "integer", "description": "ID объекта"}, "last_days": {"type": "integer", "description": "N дней (7)"}}, required=["site_id"])
async def get_economics_report(site_id: int, last_days: int = 7, **kwargs):
    """Uses the same calculation as the dashboard economics endpoint."""
    import httpx
    try:
        async with httpx.AsyncClient(timeout=15) as client:
            resp = await client.get(f"http://localhost:8000/api/economics/report/{site_id}", params={"last_days": last_days})
            if resp.status_code == 200:
                data = resp.json()
                days = data.get("days", [])
                totals = data.get("totals", {})
                # Build readable daily breakdown
                daily = []
                for d in days:
                    daily.append({
                        "date": d.get("date", ""),
                        "energy_kwh": round(d.get("energy_kwh", 0), 1),
                        "gas_m3": round(d.get("gas_m3", 0), 1),
                        "gas_cost_rub": round(d.get("cost_rub", 0) or 0, 0),
                        "cost_per_kwh": d.get("cost_per_kwh", 0),
                        "devices": d.get("devices", []),
                    })
                te = totals.get("energy_kwh", 0)
                tg = totals.get("gas_m3", 0)
                tc = totals.get("total_cost", 0) or 0
                avg_cost = totals.get("avg_cost_per_kwh", 0) or 0
                # Get grid price
                async with async_session() as db:
                    site = await db.get(Site, site_id)
                    grid_price = getattr(site, 'grid_price_kwh', None) or 8.0
                savings = round(te * grid_price - tc, 0) if te and tc else 0
                sign = "+" if savings >= 0 else ""
                effect = "ЭКОНОМИЯ" if savings >= 0 else "УБЫТОК"
                diff_word = "дешевле" if savings >= 0 else "дороже"
                diff_val = round(abs(avg_cost - grid_price), 2)
                summary = f"{effect}: {sign}{savings} руб | Генерация {diff_word} сети на {diff_val} руб/кВт*ч"
                return {
                    "site_id": site_id,
                    "period_days": last_days,
                    "grid_price_per_kwh": grid_price,
                    "daily": daily,
                    "totals": {
                        "energy_kwh": round(te, 1),
                        "gas_m3": round(tg, 1),
                        "gas_cost_rub": round(tc, 0),
                        "avg_cost_per_kwh": round(avg_cost, 2),
                        "savings_vs_grid_rub": savings,
                        "summary": summary,
                    },
                }
            else:
                return {"error": f"Economics API returned {resp.status_code}"}
    except Exception as e:
        return {"error": f"Economics API error: {str(e)}"}


@registry.tool(name="search_knowledge", description="Поиск в базе знаний (мануалы SmartGen).", parameters={"query": {"type": "string", "description": "Запрос"}}, required=["query"])
async def search_knowledge(query: str, **kwargs):
    try:
        import chromadb
        cl = chromadb.HttpClient(host="chromadb", port=8000)
        col = cl.get_or_create_collection("scada_knowledge")
        if col.count() > 0:
            res = col.query(query_texts=[query], n_results=5)
            if res and res.get("documents") and res["documents"][0]:
                return {"results": [{"content": d[:1500], "source": (mt or {}).get("source", "")} for d, mt in zip(res["documents"][0], (res.get("metadatas") or [[]])[0] or [{}]*5)], "count": len(res["documents"][0]), "method": "vector"}
    except Exception:
        pass
    async with async_session() as db:
        words = [w for w in query.split() if len(w) >= 3]
        if not words:
            return {"results": [], "count": 0}
        chunks = (await db.execute(select(AiKnowledgeChunk).where(or_(*[AiKnowledgeChunk.content.ilike(f"%{w}%") for w in words])).limit(5))).scalars().all()
        return {"results": [{"title": c.title, "content": c.content[:1500], "source": c.source_filename} for c in chunks], "count": len(chunks), "method": "ilike"}


@registry.tool(name="get_equipment_context", description="Контекст установки (ГПУ): состав, назначение, ответственный.", parameters={"unit_code": {"type": "string", "description": "mkz_gpu / yakz_gpu"}, "device_id": {"type": "integer", "description": "ID устройства → найдёт установку"}})
async def get_equipment_context(unit_code: str = None, device_id: int = None, **kwargs):
    from models.equipment_unit import EquipmentUnit
    async with async_session() as db:
        unit = None
        if unit_code:
            unit = (await db.execute(select(EquipmentUnit).where(EquipmentUnit.code == unit_code))).scalar_one_or_none()
        elif device_id:
            dev = await db.get(Device, device_id)
            if dev and getattr(dev, 'unit_id', None):
                unit = await db.get(EquipmentUnit, dev.unit_id)
        if not unit:
            return {"error": "Установка не найдена"}
        devs = (await db.execute(select(Device).where(Device.unit_id == unit.id))).scalars().all()
        return {"unit": {"id": unit.id, "name": unit.name, "type": unit.unit_type, "power_kw": unit.total_power_kw, "description": unit.description, "purpose": unit.purpose, "components": unit.components, "infrastructure": unit.infrastructure, "responsible": unit.responsible_person, "notes": unit.notes}, "devices": [{"id": d.id, "name": d.name, "type": d.device_type.value, "role": getattr(d, 'role_in_unit', None), "notes": getattr(d, 'instance_notes', None)} for d in devs]}


# ═══════════ TOOLS: ДЕЙСТВИЯ ═══════════

@registry.tool(name="propose_action", description="Предложить действие (требует подтверждения).", parameters={"device_id": {"type": "integer"}, "action_type": {"type": "string", "enum": ["set_power_limit", "start_generator", "stop_generator"]}, "params": {"type": "object"}, "reason": {"type": "string"}}, required=["device_id", "action_type", "reason"], dangerous=True)
async def propose_action(device_id: int, action_type: str, reason: str, params: dict = None, **kwargs):
    async with async_session() as db:
        a = SanekAction(device_id=device_id, action_type=action_type, params=params or {}, reason=reason, status="proposed")
        db.add(a)
        await db.commit()
        await db.refresh(a)
        return {"action_id": a.id, "status": "proposed", "description": f"{action_type} device_id={device_id}: {reason}", "requires_confirmation": True}


@registry.tool(name="execute_action", description="Выполнить подтверждённое действие.", parameters={"action_id": {"type": "integer"}}, required=["action_id"], dangerous=True)
async def execute_action(action_id: int, **kwargs):
    import httpx
    # Snapshot ПЕРЕД действием (для outcome tracking)
    before_snapshot = {}
    async with async_session() as db:
        action = await db.get(SanekAction, action_id)
        if not action:
            return {"error": f"Действие {action_id} не найдено"}
        if action.status != "proposed":
            return {"error": f"Статус {action.status}, ожидается proposed"}
        action.status = "executing"
        action.confirmed_at = datetime.utcnow()
        await db.commit()

        # Before-snapshot
        redis = await _get_redis()
        raw = await redis.get(f"device:{action.device_id}:metrics")
        if raw:
            m = json.loads(raw)
            before_snapshot = {k: m.get(k) for k in ['power_total', 'coolant_temp', 'oil_pressure', 'gen_status', 'engine_speed']}

    try:
        async with httpx.AsyncClient(base_url=_API_BASE, timeout=15) as c:
            if action.action_type == "set_power_limit":
                result = (await c.post(f"/api/devices/{action.device_id}/power-limit", json=action.params)).json()
            elif action.action_type in ("start_generator", "stop_generator"):
                cmd = "start" if "start" in action.action_type else "stop"
                result = (await c.post("/api/commands", json={"device_id": action.device_id, "function_code": 5, "address": 0 if cmd == "start" else 1, "value": 0xFF00})).json()
            else:
                result = {"error": f"Неизвестный тип: {action.action_type}"}
    except Exception as e:
        result = {"error": str(e)}

    # Сохранить результат + before-snapshot
    result_with_snapshot = {**result, "_before_snapshot": before_snapshot}
    async with async_session() as db:
        action = await db.get(SanekAction, action_id)
        action.status = "completed" if "error" not in result else "failed"
        action.executed_at = datetime.utcnow()
        action.result = result_with_snapshot
        if "error" in result:
            action.error = result["error"]
        await db.commit()

    # ═══ SELF-LEARNING: Outcome Tracking ═══
    if action.status == "completed":
        try:
            from services.outcome_tracker import ActionOutcomeTracker
            tracker = ActionOutcomeTracker()
            asyncio.create_task(tracker.schedule_tracking(action_id))
        except Exception as e:
            logger.warning("Outcome tracker: %s", e)

    return result


# ═══════════ TOOLS: ПАМЯТЬ ═══════════

@registry.tool(name="remember", description="Запомнить инструкцию/факт/предпочтение.", parameters={"content": {"type": "string"}, "category": {"type": "string", "enum": ["instruction", "fact", "preference", "context"]}}, required=["content", "category"])
async def remember(content: str, category: str = "instruction", **kwargs):
    async with async_session() as db:
        if (await db.execute(select(SanekMemory).where(and_(SanekMemory.content == content, SanekMemory.is_active == True)))).scalar_one_or_none():
            return {"status": "already_exists"}
        mem = SanekMemory(content=content, category=category, source="user")
        db.add(mem)
        await db.commit()
        return {"status": "saved", "id": mem.id}


@registry.tool(name="recall", description="Вспомнить сохранённое.", parameters={"query": {"type": "string"}, "category": {"type": "string", "enum": ["instruction", "fact", "preference", "context"]}})
async def recall(query: str = None, category: str = None, **kwargs):
    async with async_session() as db:
        q = select(SanekMemory).where(SanekMemory.is_active == True).order_by(desc(SanekMemory.created_at)).limit(30)
        if category:
            q = q.where(SanekMemory.category == category)
        if query:
            words = [w for w in query.split() if len(w) >= 3]
            if words:
                q = q.where(or_(*(SanekMemory.content.ilike(f"%{w}%") for w in words)))
        rows = (await db.execute(q)).scalars().all()
        return {"memories": [{"id": r.id, "category": r.category, "content": r.content} for r in rows], "count": len(rows)}


# ═══════════ TOOLS: САМООБУЧЕНИЕ ═══════════

@registry.tool(name="get_action_effectiveness", description="Статистика эффективности действий: какие помогали, какие нет.", parameters={"action_type": {"type": "string", "description": "Тип действия (опц.)"}, "device_id": {"type": "integer", "description": "ID устройства (опц.)"}})
async def get_action_effectiveness(action_type: str = None, device_id: int = None, **kwargs):
    async with async_session() as db:
        q = select(SanekAction).where(SanekAction.status == "completed")
        if action_type:
            q = q.where(SanekAction.action_type == action_type)
        if device_id:
            q = q.where(SanekAction.device_id == device_id)
        actions = (await db.execute(q.order_by(SanekAction.executed_at.desc()).limit(50))).scalars().all()
        stats = {"total": 0, "better": 0, "same": 0, "worse": 0, "unknown": 0}
        for a in actions:
            outcomes = getattr(a, 'outcome_analysis', None) or []
            if not outcomes:
                stats["unknown"] += 1
                continue
            last = outcomes[-1]
            v = last.get('assessment', 'unknown')
            stats[v] = stats.get(v, 0) + 1
            stats["total"] += 1
        stats["effectiveness_pct"] = round(stats["better"] / stats["total"] * 100, 1) if stats["total"] > 0 else 0
        return stats


